{
  "name": "pixestudio-next",
  "private": true,
  "version": "0.1.0",
  "description": "PixeStudio, éditeur Windows de contenus pédagogiques interactifs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @pixestudio/desktop run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:functional": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "tauri:dev": "npm --workspace @pixestudio/desktop run build && tauri dev",
    "tauri:build": "npm --workspace @pixestudio/desktop run build && tauri build",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tauri-apps/cli": "^2.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
